Follow https://www.gem5.org/documentation/general_docs/gpu_models/gpufs:


step 1:
cd gem5
scons build/VEGA_X86/gem5.opt

Step 2: 
cd gem5-resources/src/x86-ubuntu-gpu-ml
./build.sh

I was getting error here. I fixed it as:

diff --git a/src/x86-ubuntu-gpu-ml/x86-ubuntu-gpu-ml.pkr.hcl b/src/x86-ubuntu-gpu-ml/x86-ubuntu-gpu-ml.pkr.hcl
index 4e7c2936..b646fcfa 100644
--- a/src/x86-ubuntu-gpu-ml/x86-ubuntu-gpu-ml.pkr.hcl
+++ b/src/x86-ubuntu-gpu-ml/x86-ubuntu-gpu-ml.pkr.hcl
@@ -44,8 +44,8 @@ source "qemu" "initialize" {
   format           = "raw"
   headless         = "true"
   http_directory   = "http"
-  iso_checksum     = "sha256:d6dab0c3a657988501b4bd76f1297c053df710e06e0c3aece60dead24f270b4d"
-  iso_urls         = ["https://releases.ubuntu.com/24.04.2/ubuntu-24.04.2-live-server-amd64.iso"]
+  iso_checksum     = "sha256:97f3d7ffb032c3eb3b23d2c8be9cc76e60c2c1f2c0146ba5ba9fe01cafae0fd8"
+  iso_urls         = ["https://releases.ubuntu.com/24.04/ubuntu-24.04.5-live-server-amd64.iso"]
   memory           = "8192"
   output_directory = "disk-image"
   qemu_binary      = "${var.qemu_path}"


Step 3:
cd gem5-resources/src/gpu/square
docker run --rm -u $UID:$GID -v $PWD:$PWD -w $PWD ghcr.io/gem5/gpu-fs make -f Makefile.default

Step 4:
cd gem5
build/VEGA_X86/gem5.opt \
  configs/example/gpufs/mi300.py \
  --disk-image gem5-resources/src/x86-ubuntu-gpu-ml/disk-image/x86-ubuntu-gpu-ml \
  --kernel gem5-resources/src/x86-ubuntu-gpu-ml/vmlinux-gpu-ml \
  --app gem5-resources/src/gpu/square/bin.default/square.default
  
Note that, you need to add ../ before gem5-resources. This command is the same as mentioned on the webpage as following, but I often miss the ../ and get error:
  
build/VEGA_X86/gem5.opt configs/example/gpufs/mi300.py --disk-image gem5-resources/src/x86-ubuntu-gpu-ml/disk-image/x86-ubuntu-gpu-ml --kernel gem5-resources/src/x86-ubuntu-gpu-ml/vmlinux-gpu-ml --app gem5-resources/src/gpu/square/bin.default/square.default
